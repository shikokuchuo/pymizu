# setuptools_scm's file finder supplies every tracked file; this file only
# narrows. Keep the sdist to the package, its tests and tools: agent notes,
# CI, pre-commit and coverage config, the Makefile, the docs sources, the
# agent skill and the benchmarks are checkout-only.
exclude AGENTS.md
exclude .gitignore
exclude .pre-commit-config.yaml
exclude codecov.yml
exclude Makefile
prune .github
prune benchmarks
prune docs
prune skills
